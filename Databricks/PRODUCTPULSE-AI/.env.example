# Copy this file to `.env` only when running Streamlit locally from your laptop:
#   cp .env.example .env
#
# Do not put real values in `.env.example`.
# Do not commit `.env`.
#
# Databricks Workflows use notebook/job parameters instead of this local file.
# Databricks Apps use app environment variables and attached Lakebase resources.

# Required only for local Streamlit runs.
# Example: https://dbc-12345678-90ab.cloud.databricks.com
DATABRICKS_HOST=

# Required only for local Streamlit runs.
# Use a personal access token from your Databricks user settings.
DATABRICKS_TOKEN=

# Required for the agent's structured metric tool.
# Find it in SQL Warehouses -> your warehouse -> Connection details -> HTTP path.
DATABRICKS_SQL_HTTP_PATH=

# Unity Catalog location used by the app and Python modules.
# Keep these aligned with the job parameters in Databricks Workflows.
PRODUCTPULSE_CATALOG=adidas_retail_ai
PRODUCTPULSE_SCHEMA=productpulse

# Databricks Foundation Model API endpoints.
# Change only if your workspace uses different serving endpoint names.
PRODUCTPULSE_EMBEDDING_MODEL=databricks-qwen3-embedding-0-6b
PRODUCTPULSE_LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Lakebase Postgres connection values.
# Required for local Streamlit runs and for notebooks when supplied as widgets.
# In Databricks Apps, these are injected after attaching a Lakebase database
# resource, so you usually do not manually set PGHOST/PGUSER there.
PGHOST=
PGPORT=5432
# Lakebase creates this default database when the project is created.
PGDATABASE=databricks_postgres
PGUSER=

# Optional for local runs if you use a static password role.
# For Databricks Apps with Lakebase Autoscaling, leave this blank. The app code
# generates a short-lived OAuth database credential from LAKEBASE_ENDPOINT.
PGPASSWORD=
PGSSLMODE=require

# Required for Databricks Apps with Lakebase Autoscaling OAuth token generation.
# In app.yaml this is populated with `valueFrom: postgres` after you attach a
# Lakebase database resource with resource key `postgres`.
# For local runs, copy the endpoint resource name from Lakebase:
# projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>
LAKEBASE_ENDPOINT=

# Retrieval behavior.
PRODUCTPULSE_TOP_K=8
PRODUCTPULSE_RERANK_K=4
